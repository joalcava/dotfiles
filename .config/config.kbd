(defcfg
  ;; For Linux

  input  (device-file "/dev/input/by-path/platform-i8042-serio-0-event-kbd")
  output (uinput-sink 
    "My KMonad output"
    "/usr/bin/sleep 1 && /usr/bin/setxkbmap -option compose:ralt")

  fallthrough true
)

(defsrc
  tab   q    w    e    r    t    y    u    i    o    p
  caps  a    s    d    f    g    h    j    k    l    ;
  lsft  z    x    c    v    b    n    m    ,    .    /
)

(defalias
    ctl_z (tap-hold-next-release 200 z lctl)
    alt_s (tap-hold-next-release 200 s lalt)
    met_d (tap-hold-next-release 200 d lmet)
    sft_f (tap-hold-next-release 200 f lsft)

    sft_j (tap-hold-next-release 200 j rsft)
    met_k (tap-hold-next-release 200 k rmet)
    alt_l (tap-hold-next-release 200 l lalt)
    ctl__ (tap-hold-next-release 200 ; rctl)
)

(deflayer default
    tab   q       w       e       r       t   y   u   i   o       p
    esc   a       @alt_s  @met_d  @sft_f  g   h   j   k   l  @ctl__
    lsft  @ctl_z  x       c       v       b   n   m   ,   .       /
)
